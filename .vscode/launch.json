{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}\\backend",
      "python": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Frontend Browser",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}\\frontend\\src",
      "preLaunchTask": "Run Frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend API", "Frontend Browser"],
      "stopAll": true
    }
  ]
}
